from transformers import (
    AutoModelForSpeechSeq2Seq,
    AutoProcessor,
    BitsAndBytesConfig,
)





MODEL_ID = "openai/whisper-large-v3"

# 改成你训练完成后的 LoRA 目录
ADAPTER_DIR = (
    "/sigan/ai-ml/models/whisper-large-v3-zh-china-north-lora"
)

CV_ROOT = Path(
    "/home/sigan/datasets/common_voice_27_zh/"
    "cv-corpus-27.0-2026-09-11/zh-CN"
)

# 20 条测试音频同步到这个目录
TEST_AUDIO_DIR = Path(
    "/sigan/ai-ml/datasets/"
    "common-voice-27-beijing-test2"
)

# 测试时读取 source test.tsv
TEST_TSV = CV_ROOT / "test.tsv"

ACCENTS = {
    "出生地：11 北京市",
    "出生地：23 黑龙江省",
    "出生地：37 山东省",
    # "出生地：32 江苏省",
    # "出生地：41 河南省",
    # "出生地：33 浙江省",
    # "出生地：51 四川省",
}
NUM_SAMPLES = 20

SAMPLING_RATE = 16000
MAX_NEW_TOKENS = 100
NUM_BEAMS = 1
DEVICE = "cuda"

TEST_AUDIO_DIR.mkdir(parents=True, exist_ok=True)





# ============================================================
# 2. 中文文本归一化
# ============================================================

def clean_text(text):
    """标准答案和模型输出都使用完全相同的归一化规则。"""
    text = normalize_chinese(
        text,
        remove_punctuation=True,
    )

    # OpenCC t2s 不会把“妳”转换为“你”，这里单独统一
    return text.replace("妳", "你")


# ============================================================
# 3. 抽取 20 条北京测试音频并同步到目录
# ============================================================

with TEST_TSV.open(
    encoding="utf-8",
    newline="",
) as handle:
    reader = csv.DictReader(handle, delimiter="\t")

    test_rows = []
    selected_speakers = set()

    for row in reader:
        # 必须是 not in，不能再用 != TARGET_ACCENT
        if row["accents"] not in ACCENTS:
            continue

        if row["client_id"] in selected_speakers:
            continue

        test_rows.append(row)
        selected_speakers.add(row["client_id"])

        if len(test_rows) >= NUM_SAMPLES:
            break

if len(test_rows) != NUM_SAMPLES:
    raise RuntimeError(
        f"只找到 {len(test_rows)} 条目标地区测试数据，"
        f"不足 {NUM_SAMPLES} 条"
    )

# 同步音频：从原始 clips 复制到 test1 目录
manifest_rows = []

for index, row in enumerate(test_rows, start=1):
    filename = row["path"]
    source = CV_ROOT / "clips" / filename
    destination = TEST_AUDIO_DIR / filename

    # 复制音频；重复运行时覆盖成同一份文件
    shutil.copy2(source, destination)

    manifest_rows.append({
        "序号": index,
        "文件名": filename,
        "标准答案": row["sentence"],
        "地区": row["accents"],
        "说话人": row["client_id"][:8],
    })

manifest_df = pd.DataFrame(manifest_rows)

print("测试音频目录：", TEST_AUDIO_DIR)
print("已同步音频数量：", len(manifest_df))
display(manifest_df)





import re
import unicodedata
import opencc

_t2s = opencc.OpenCC("t2s")

def normalize_chinese(text, remove_punctuation=False):
    if text is None:
        return ""

    text = _t2s.convert(text)
    text = unicodedata.normalize("NFKC", text)
    text = text.lower()
    text = re.sub(r"\s+", "", text)

    if remove_punctuation:
        text = re.sub(
            r"[，。？！：；、（）【】｛｝,\.\?!:;()\[\]{}]",
            "",
            text,
        )

    return text.strip()


def clean_text(text):
    text = normalize_chinese(
        text,
        remove_punctuation=True,
    )
    return text.replace("妳", "你")


# ============================================================
# 4. 加载 Processor
# ============================================================

processor = AutoProcessor.from_pretrained(
    MODEL_ID,
    language="Chinese",
    task="transcribe",
)

forced_decoder_ids = processor.get_decoder_prompt_ids(
    language="chinese",
    task="transcribe",
)


# ============================================================
# 5. 从同步后的目录读取音频并提取特征
# ============================================================

filenames = manifest_df["文件名"].tolist()
references = []
input_features = []

for index, row in enumerate(test_rows, start=1):
    # 注意：这里从 test1 目录读取，不再读取原始 clips
    audio_path = TEST_AUDIO_DIR / row["path"]

    audio, _ = librosa.load(
        str(audio_path),
        sr=SAMPLING_RATE,
    )

    feature = processor(
        audio,
        sampling_rate=SAMPLING_RATE,
        return_tensors="pt",
    )["input_features"][0]

    # 标准答案也执行归一化
    references.append(
        clean_text(row["sentence"])
    )
    input_features.append(feature)

    print(f"已加载：{index}/{NUM_SAMPLES}")





def run_test(use_lora):
    """
    use_lora=False：原始 Whisper large-v3
    use_lora=True ：Whisper large-v3 + LoRA
    """

    print("\n加载模型，use_lora =", use_lora)

    base_model = AutoModelForSpeechSeq2Seq.from_pretrained(
        MODEL_ID,
        quantization_config=BitsAndBytesConfig(
            load_in_8bit=True
        ),
        device_map="auto",
    )

    # 推理阶段开启 KV Cache，减少生成耗时
    base_model.config.use_cache = True

    model = base_model

    if use_lora:
        model = PeftModel.from_pretrained(
            base_model,
            ADAPTER_DIR,
        )

    model.eval()

    # 强制使用中文转写任务
    model.generation_config.forced_decoder_ids = (
        forced_decoder_ids
    )

    predictions = []
    start_time = time.perf_counter()

    for index, feature in enumerate(
        input_features,
        start=1,
    ):
        inputs = {
            "input_features": (
                feature
                .unsqueeze(0)
                .to(DEVICE)
                .half()
            )
        }

        with torch.inference_mode():
            output_ids = model.generate(
                **inputs,
                max_new_tokens=MAX_NEW_TOKENS,
                num_beams=NUM_BEAMS,
            )

        prediction = processor.batch_decode(
            output_ids,
            skip_special_tokens=True,
        )[0]

        # 模型输出也做归一化
        predictions.append(
            clean_text(prediction)
        )

        print(f"已生成：{index}/{NUM_SAMPLES}")

    elapsed = time.perf_counter() - start_time

    # 释放显存，准备加载下一个模型
    del model
    del base_model
    gc.collect()
    torch.cuda.empty_cache()

    return predictions, elapsed


# 原始 V3
base_predictions, base_time = run_test(
    use_lora=False
)

# V3 + 北京 LoRA
lora_predictions, lora_time = run_test(
    use_lora=True
)





# ============================================================
# 7. 计算总体 CER
