    base_model = AutoModelForSpeechSeq2Seq.from_pretrained(
        MODEL_ID,
        quantization_config=BitsAndBytesConfig(
            load_in_8bit=True
        ),
        device_map="auto",
    )

    # 推理阶段开启 KV Cache，减少生成耗时
    base_model.config.use_cache = True

    model = base_model

    if use_lora:
        model = PeftModel.from_pretrained(
            base_model,
            ADAPTER_DIR,
        )

    model.eval()

    # 强制使用中文转写任务
    model.generation_config.forced_decoder_ids = (
        forced_decoder_ids
    )

    predictions = []
    start_time = time.perf_counter()

    for index, feature in enumerate(
        input_features,
        start=1,
    ):
        inputs = {
            "input_features": (
                feature
                .unsqueeze(0)
                .to(DEVICE)
                .half()
            )
        }

        with torch.inference_mode():
            output_ids = model.generate(
                **inputs,
                max_new_tokens=MAX_NEW_TOKENS,
                num_beams=NUM_BEAMS,
            )

        prediction = processor.batch_decode(
            output_ids,
            skip_special_tokens=True,
        )[0]

        # 模型输出也做归一化
        predictions.append(
            clean_text(prediction)
        )

        print(f"已生成：{index}/{NUM_SAMPLES}")

    elapsed = time.perf_counter() - start_time

    # 释放显存，准备加载下一个模型
    del model
    del base_model
    gc.collect()
    torch.cuda.empty_cache()

    return predictions, elapsed


# 原始 V3
base_predictions, base_time = run_test(
    use_lora=False
)

# V3 + 北京 LoRA
lora_predictions, lora_time = run_test(
    use_lora=True
)





# ============================================================
# 7. 计算总体 CER
# ============================================================

base_cer = jiwer.cer(
    reference=references,
    hypothesis=base_predictions,
)

lora_cer = jiwer.cer(
