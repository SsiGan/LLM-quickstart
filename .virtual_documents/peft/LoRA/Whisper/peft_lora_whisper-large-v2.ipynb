from pathlib import Path

from datasets import Audio, DatasetDict, load_dataset

dataset_path = Path(
    "/home/sigan/datasets/common_voice_27_zh/"
    "cv-corpus-27.0-2026-09-11/zh-CN"
)

clips_path = dataset_path / "clips"


def load_split(tsv_name):
    # 读取 TSV
    dataset = load_dataset(
        "csv",
        data_files=str(dataset_path / tsv_name),
        delimiter="\t",
        keep_default_na=False,
    )["train"]

    # path 只是文件名，这里补成完整音频路径
    dataset = dataset.map(
        lambda batch: {
            "audio": [
                str(clips_path / name)
                for name in batch["path"]
            ]
        },
        batched=True,
    )

    # 统一转换成 16kHz 音频
    dataset = dataset.cast_column(
        "audio",
        Audio(sampling_rate=16000),
    )

    # 后面只用 audio 和 sentence
    return dataset.select_columns(
        ["audio", "sentence"]
    )


common_voice = DatasetDict({
