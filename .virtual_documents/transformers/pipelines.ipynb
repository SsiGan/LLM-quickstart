import torch
from transformers import AutoTokenizer, pipeline

model_id = "Qwen/Qwen2.5-3B-Instruct"

tokenizer = AutoTokenizer.from_pretrained(model_id)

writer = pipeline(
    "text-generation",
    model=model_id,
    tokenizer=tokenizer,
    torch_dtype=torch.bfloat16,
    device=0,
)


messages = [
    {
        "role": "system",
        "content": (
            "你是中文小说写作助手。"
            "叙事要贴近原著腔调，重视人物对话、动作和环境细节；"
            "感情表达甜而不腻，不替角色做不符合人设的决定。"
        ),
    },
    {
        "role": "user",
        "content": (
            "写一个约300字的小说片段。"
            "场景是雨夜的车站，两个关系暧昧但尚未表白的人再次见面。"
            "结尾停在一方准备说出口、却被列车进站声打断的时候。"
        ),
    },
]

prompt = tokenizer.apply_chat_template(
    messages,
    tokenize=False,
    add_generation_prompt=True,
)

result = writer(
    prompt,
    max_new_tokens=300,
    do_sample=True,
    temperature=0.8,
    top_p=0.9,
    repetition_penalty=1.08,
    return_full_text=False,
)

print(result[0]["generated_text"])



