            <= start_char
        ):
            token_start_index += 1

        while (
            offsets[token_end_index][1]
            >= end_char
        ):
            token_end_index -= 1

        tokenized_examples[
            "start_positions"
        ].append(token_start_index - 1)

        tokenized_examples[
            "end_positions"
        ].append(token_end_index + 1)

    return tokenized_examples


